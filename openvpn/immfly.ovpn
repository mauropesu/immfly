client
dev tun-immfly
remote bcn1.vpn.immfly.io 11094 tcp
tun-mtu 1450
tls-client
nobind
user nobody
group nogroup
ping 15
ping-restart 45
persist-tun
persist-key
mute-replay-warnings
verb 3
cipher AES-256-CBC
data-ciphers AES-256-CBC
auth SHA256
pull
auth-user-pass
connect-retry 1
reneg-sec 0
auth-nocache
disable-dco

#script-security 2
#up /etc/openvpn/update-resolv-conf
#down /etc/openvpn/update-resolv-conf

remote-cert-tls server

auth-user-pass auth.ovpn
ca ca.pem
cert freddy.perez.pem
key freddy.perez.key
